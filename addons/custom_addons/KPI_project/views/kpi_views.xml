<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task KPI view: per-project task statistics -->
    <record id="view_project_kpi_dashboard" model="ir.ui.view">
        <field name="name">Project KPI Dashboard</field>
        <field name="model">project.project</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Project KPIs" create="false" delete="false">
                <field name="name" string="Project"/>
                <field name="total_tasks" string="Total Tasks"/>
                <field name="completed_tasks" string="Completed Tasks"/>
                <field name="active_tasks" string="Active Tasks"/>
                <field name="completion_rate" string="Completion Rate" widget="percentage"/>
            </list>
        </field>
    </record>

    <!-- Manager Workload list view: one row per project showing manager and their load -->
    <record id="view_project_manager_workload" model="ir.ui.view">
        <field name="name">Project Manager Workload</field>
        <field name="model">project.project</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Manager Workload" create="false" delete="false"
                  default_group_by="user_id">
                <field name="name" string="Project"/>
                <field name="user_id" string="Project Manager"/>
                <field name="manager_workload" string="Manager Active Projects"/>
            </list>
        </field>
    </record>

    <!-- Manager Workload graph view: project count per manager over time -->
    <record id="view_project_manager_workload_graph" model="ir.ui.view">
        <field name="name">Project Manager Workload Graph</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <graph string="Manager Workload Over Time" type="bar" stacked="1">
                <field name="date_start" interval="month" type="row" string="Month"/>
                <field name="user_id" type="row" string="Project Manager"/>
            </graph>
        </field>
    </record>

    <!-- Manager Workload pivot view: tabular breakdown by manager and month -->
    <record id="view_project_manager_workload_pivot" model="ir.ui.view">
        <field name="name">Project Manager Workload Pivot</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <pivot string="Manager Workload Over Time" display_quantity="true">
                <field name="user_id" type="row" string="Project Manager"/>
                <field name="date_start" interval="month" type="col" string="Month"/>
            </pivot>
        </field>
    </record>

    <!-- Snapshot line chart: workload per manager over time -->
    <record id="view_kpi_snapshot_line" model="ir.ui.view">
        <field name="name">KPI Snapshot Line</field>
        <field name="model">project.kpi.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Manager Workload Over Time" type="line">
                <field name="snapshot_date" interval="week" type="row" string="Week"/>
                <field name="user_id" type="row" string="Project Manager"/>
                <field name="workload" type="measure" string="Active Projects"/>
            </graph>
        </field>
    </record>

    <!-- Snapshot bar chart: historical workload per manager per week -->
    <record id="view_kpi_snapshot_graph" model="ir.ui.view">
        <field name="name">KPI Snapshot Graph</field>
        <field name="model">project.kpi.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Manager Workload History" type="bar" stacked="1">
                <field name="snapshot_date" interval="week" type="row" string="Week"/>
                <field name="user_id" type="row" string="Project Manager"/>
                <field name="workload" type="measure" string="Active Projects"/>
            </graph>
        </field>
    </record>

    <!-- Snapshot pivot: tabular breakdown of historical workload -->
    <record id="view_kpi_snapshot_pivot" model="ir.ui.view">
        <field name="name">KPI Snapshot Pivot</field>
        <field name="model">project.kpi.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Manager Workload History" display_quantity="true">
                <field name="user_id" type="row" string="Project Manager"/>
                <field name="snapshot_date" interval="week" type="col" string="Week"/>
                <field name="workload" type="measure" string="Active Projects"/>
            </pivot>
        </field>
    </record>

    <!-- Snapshot list: raw snapshot records -->
    <record id="view_kpi_snapshot_list" model="ir.ui.view">
        <field name="name">KPI Snapshot List</field>
        <field name="model">project.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list string="Workload Snapshots" create="false" delete="false"
                  default_order="snapshot_date desc">
                <field name="snapshot_date" string="Date"/>
                <field name="user_id" string="Project Manager"/>
                <field name="workload" string="Active Projects"/>
            </list>
        </field>
    </record>

    <!-- ── Tasks Completed Per Week ──────────────────────────────────────── -->

    <!-- Line chart: tasks completed per assignee per week -->
    <record id="view_kpi_tasks_completed_line" model="ir.ui.view">
        <field name="name">KPI Tasks Completed Line</field>
        <field name="model">project.kpi.tasks.completed.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Tasks Completed Per Week" type="line">
                <field name="snapshot_date" interval="week" type="row" string="Week"/>
                <field name="user_id" type="row" string="Assignee"/>
                <field name="tasks_completed" type="measure" string="Tasks Completed"/>
            </graph>
        </field>
    </record>

    <!-- Bar chart: stacked tasks completed per assignee per week -->
    <record id="view_kpi_tasks_completed_graph" model="ir.ui.view">
        <field name="name">KPI Tasks Completed Bar</field>
        <field name="model">project.kpi.tasks.completed.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Tasks Completed History" type="bar" stacked="1">
                <field name="snapshot_date" interval="week" type="row" string="Week"/>
                <field name="user_id" type="row" string="Assignee"/>
                <field name="tasks_completed" type="measure" string="Tasks Completed"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: assignees as rows, weeks as columns -->
    <record id="view_kpi_tasks_completed_pivot" model="ir.ui.view">
        <field name="name">KPI Tasks Completed Pivot</field>
        <field name="model">project.kpi.tasks.completed.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Tasks Completed History" display_quantity="true">
                <field name="user_id" type="row" string="Assignee"/>
                <field name="snapshot_date" interval="week" type="col" string="Week"/>
                <field name="tasks_completed" type="measure" string="Tasks Completed"/>
            </pivot>
        </field>
    </record>

    <!-- List: raw snapshot records -->
    <record id="view_kpi_tasks_completed_list" model="ir.ui.view">
        <field name="name">KPI Tasks Completed List</field>
        <field name="model">project.kpi.tasks.completed.snapshot</field>
        <field name="arch" type="xml">
            <list string="Tasks Completed Snapshots" create="false" delete="false"
                  default_order="snapshot_date desc">
                <field name="snapshot_date" string="Week Start"/>
                <field name="user_id" string="Assignee"/>
                <field name="tasks_completed" string="Tasks Completed"/>
            </list>
        </field>
    </record>

    <!-- ── Task Planning Completeness ───────────────────────────────────── -->

    <!-- Line chart: completeness rate over time -->
    <record id="view_kpi_planning_line" model="ir.ui.view">
        <field name="name">KPI Planning Completeness Line</field>
        <field name="model">project.kpi.planning.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Task Planning Completeness Over Time" type="line">
                <field name="snapshot_date" interval="day" type="row" string="Date"/>
                <field name="completeness_rate" type="measure" string="Completeness Rate (%)"/>
            </graph>
        </field>
    </record>

    <!-- Bar chart: planned vs total projects per day -->
    <record id="view_kpi_planning_bar" model="ir.ui.view">
        <field name="name">KPI Planning Completeness Bar</field>
        <field name="model">project.kpi.planning.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Task Planning Completeness" type="bar">
                <field name="snapshot_date" interval="day" type="row" string="Date"/>
                <field name="planned_projects" type="measure" string="Projects with Planned Tasks"/>
                <field name="total_projects" type="measure" string="Total Active Projects"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: dates as columns, metrics as measures -->
    <record id="view_kpi_planning_pivot" model="ir.ui.view">
        <field name="name">KPI Planning Completeness Pivot</field>
        <field name="model">project.kpi.planning.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Task Planning Completeness" display_quantity="true">
                <field name="snapshot_date" interval="day" type="col" string="Date"/>
                <field name="completeness_rate" type="measure" string="Completeness Rate (%)"/>
                <field name="planned_projects" type="measure" string="Projects with Planned Tasks"/>
                <field name="total_projects" type="measure" string="Total Active Projects"/>
            </pivot>
        </field>
    </record>

    <!-- List: raw planning snapshot records -->
    <record id="view_kpi_planning_list" model="ir.ui.view">
        <field name="name">KPI Planning Completeness List</field>
        <field name="model">project.kpi.planning.snapshot</field>
        <field name="arch" type="xml">
            <list string="Planning Completeness Snapshots" create="false" delete="false"
                  default_order="snapshot_date desc">
                <field name="snapshot_date" string="Date"/>
                <field name="total_projects" string="Total Active Projects"/>
                <field name="planned_projects" string="Projects with Planned Tasks"/>
                <field name="completeness_rate" string="Completeness Rate (%)"/>
            </list>
        </field>
    </record>

    <!-- ── Project Staleness (avg days since last update) ───────────────── -->

    <!-- Line chart: average days since last update per day -->
    <record id="view_kpi_staleness_line" model="ir.ui.view">
        <field name="name">KPI Staleness Line</field>
        <field name="model">project.kpi.staleness.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Avg Days Since Last Project Update" type="line">
                <field name="snapshot_date" interval="day" type="row" string="Date"/>
                <field name="days_since_last_update" type="measure" string="Avg Days Since Last Update"/>
            </graph>
        </field>
    </record>

    <!-- Bar chart: staleness per project on the latest snapshot -->
    <record id="view_kpi_staleness_bar" model="ir.ui.view">
        <field name="name">KPI Staleness Bar</field>
        <field name="model">project.kpi.staleness.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Days Since Last Update Per Project" type="bar">
                <field name="project_id" type="row" string="Project"/>
                <field name="days_since_last_update" type="measure" string="Days Since Last Update"/>
            </graph>
        </field>
    </record>

    <!-- Pivot: projects as rows, dates as columns -->
    <record id="view_kpi_staleness_pivot" model="ir.ui.view">
        <field name="name">KPI Staleness Pivot</field>
        <field name="model">project.kpi.staleness.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Project Staleness History" display_quantity="true">
                <field name="project_id" type="row" string="Project"/>
                <field name="snapshot_date" interval="week" type="col" string="Week"/>
                <field name="days_since_last_update" type="measure" string="Days Since Last Update"/>
            </pivot>
        </field>
    </record>

    <!-- List: raw staleness snapshot records -->
    <record id="view_kpi_staleness_list" model="ir.ui.view">
        <field name="name">KPI Staleness List</field>
        <field name="model">project.kpi.staleness.snapshot</field>
        <field name="arch" type="xml">
            <list string="Staleness Snapshots" create="false" delete="false"
                  default_order="snapshot_date desc, days_since_last_update desc">
                <field name="snapshot_date" string="Date"/>
                <field name="project_id" string="Project"/>
                <field name="days_since_last_update" string="Days Since Last Update" digits="[10,1]"/>
            </list>
        </field>
    </record>
</odoo>
