<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_checklist" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.checklist</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="replace">
                <page string="Internal Notes" name="internal_notes">

                    <!-- ── FREE-TEXT INTERNAL NOTES ─────────────────────── -->
                    <field name="description"
                           placeholder="Add a note..."
                           options="{'collaborative': true}"/>

                    <!-- ── COMMERCIAL LEVEL ─────────────────────────────── -->
                    <separator string="Commercial Level"/>
                    <div class="alert alert-info mb-3" role="status">
                        Clear answers are needed on the following questions
                        <strong>before</strong> we launch a request on the Higo side.
                    </div>
                    <div class="o_checklist_wider_labels">
                    <group col="1">
                        <field name="x_cl_end_customer"      nolabel="0"/>
                        <field name="x_cl_known_partners"    nolabel="0"/>
                        <field name="x_cl_dmu"               nolabel="0"/>
                        <field name="x_cl_location"          nolabel="0"/>
                        <field name="x_cl_sop"               nolabel="0"/>
                        <field name="x_cl_qty_lifetime"      nolabel="0"/>
                        <field name="x_cl_milestones"        nolabel="0"/>
                        <field name="x_cl_using_now"         nolabel="0"/>
                        <field name="x_cl_comparing_with"    nolabel="0"/>
                        <field name="x_cl_status_company"    nolabel="0"/>
                    </group>
                    </div>

                    <!-- ── TECHNICAL LEVEL ──────────────────────────────── -->
                    <separator string="Technical Level"/>
                    <div class="alert alert-warning mb-3" role="status">
                        Gather criteria that are required for making a suitable offer or new design.
                    </div>
                    <div class="o_checklist_wider_labels">
                    <group col="1">
                        <field name="x_tl_connector_types"       nolabel="0"/>
                        <field name="x_tl_mating_cycles"         nolabel="0"/>
                        <field name="x_tl_current_voltage"       nolabel="0"/>
                        <field name="x_tl_budget"                nolabel="0"/>
                        <field name="x_tl_ip_level"              nolabel="0"/>
                        <field name="x_tl_size_restrictions"     nolabel="0"/>
                        <field name="x_tl_material_restrictions" nolabel="0"/>
                        <field name="x_tl_wiring_diagrams"       nolabel="0"/>
                        <field name="x_tl_cable_lengths"         nolabel="0"/>
                        <field name="x_tl_compliance"            nolabel="0"/>
                    </group>
                    </div>
                    <group>
                        <field name="x_tl_additional_notes" nolabel="0"/>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>
